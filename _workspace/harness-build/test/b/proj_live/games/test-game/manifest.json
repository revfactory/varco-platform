   "source_ref": "data/dialogue.csv:scene=ch1_boss",
   "brief": "장면 ch1_boss 크리처 음성 1줄(golem). 가이드 음성을 TTS 로 만들고 크리처 참조음을 text2sound 로 한 번 만든 뒤 줄마다 Conversion 한다. 음색: golem: 낮게 울리는 돌 괴물. 사람이 녹음한 가이드가 있으면 inputs 에 넣고 step1 을 건너뛴다.",
   "lines": [
    "ch1_boss_001"
   ],
   "inputs": [],
   "steps": [
    {
     "api": "tts.standard",
     "params": {
      "language": "korean"
     },
     "calls": 1,
     "per_call_chars": [
      5
     ]
    },
    {
     "api": "sound.text2sound",
     "params": {
      "prompt": "creature vocal reference: golem: 낮게 울리는 돌 괴물",
      "num_sample": 1,
      "version": "v2"
     }
    },
    {
     "api": "sound.conversion",
     "input_from": {
      "source": "step1",
      "reference": "step2"
     },
     "params": {
      "ratio": 1.0,
      "enhance": false
     },
     "calls": 1
    }
   ],
