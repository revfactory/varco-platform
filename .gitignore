# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# 비밀 정보: VARCO 키는 .env 에 두고 절대 커밋하지 않는다
.env
.env.*

# 실행 중에 생기는 잠금·프로세스 파일
*.lock
*.pid

# 쇼릴 렌더 중간본(최종본은 루트의 VARCO-Game-Studio-Showreel.mp4)
_workspace/showreel/out/
_workspace/showreel/frames/
_workspace/showreel/audio/pre_master.wav
# README GIF 를 만들 때 잘라 낸 중간 영상 조각
_workspace/readme-media/*.mp4
# 2분 제작 과정 영상 렌더 중간본(최종본은 루트의 VARCO-Game-Studio-Process.mp4)
_workspace/process/out/
_workspace/process/audio/pre_master.wav
